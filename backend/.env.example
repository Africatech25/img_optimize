# Backend - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# Port du serveur (defaut: 8000)
PORT=8000

# Origines CORS autorisees (separes par virgule)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Taille maximale des uploads en MB (defaut: 50)
MAX_UPLOAD_SIZE_MB=50

# Nombre maximum de jobs concurrents (defaut: 20)
MAX_CONCURRENT_JOBS=20

# Téléchargement vidéo par URL (defaut: 500)
MAX_DOWNLOAD_SIZE_MB=500

# Plateformes autorisees pour le telechargement (defaut: toutes)
# DOWNLOAD_ALLOWED_DOMAINS=youtube.com,youtu.be,tiktok.com,facebook.com,fb.watch,instagram.com,vimeo.com,twitter.com,x.com,twitch.tv
